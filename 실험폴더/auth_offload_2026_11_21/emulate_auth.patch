 		Disconnect(id); // 밀려 있다 - Redis에 묻지 않고 바로 끊는다(응답 없음)
 		return;
 	}
+	if (sbEmuAuth)
+	{
+		emuLoginWork(); // 측정용 - 로그인 서버의 일을 이 워커에서
