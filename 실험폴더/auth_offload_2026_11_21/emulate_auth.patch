 #include "LoginProtocol.h"
 #include "SecureChannel.h"
 #include "SessionAuth.h"
+#include <atomic>
+#include <cstdlib>
+#include "LoginCrypto.h"
+#include "PasswordHash.h"
+
+// ===== 측정용(커밋 안 함): 환경 변수 ARK_EMULATE_AUTH=1이면 "게임 서버가 인증까지 하는 구조"를 흉내 낸다 =====
+// 로그인 서버가 한 번의 로그인에 워커에서 하는 일을 입장 처리(워커)에 그대로 더한다:
+// Hello 때 서버 고정 키 서명 1번, 입장 요청 때 비밀 키 연산 3번(요청 풀기·응답 서명·AuthAck 풀기를 서명으로 대신) + Argon2id(64MiB·2회) + 두 입장마다 키 쌍 만들기
+static bool sbEmuAuth = false;
+static PasswordHasher* sEmuHasher = nullptr;
+static RsaKey* sEmuSignKey = nullptr;
+static std::atomic<int64_t> sEmuEntryCnt{ 0 };
+
+static void initEmuAuth()
+{
+	char value[8] = {};
+	size_t got = 0;
+	if (getenv_s(&got, value, sizeof(value), "ARK_EMULATE_AUTH") != 0 || got == 0 || value[0] != '1')
+	{
+		return;
+	}
+	PasswordHashConfig config;
+	config.Pepper.assign(32, '\x5a');
+	config.OpsLimit = 2;
+	config.MemLimit = 64ull << 20;
+	sEmuHasher = New<PasswordHasher>(config);
+	sEmuSignKey = New<RsaKey>();
+	const bool bOk = sEmuSignKey->Generate();
+	Assert(bOk, "측정용 키 만들기 실패");
+	sbEmuAuth = true;
+	printf("[main] 측정용: 게임 서버가 인증까지 하는 구조를 흉내 낸다(ARK_EMULATE_AUTH=1)\n");
+}
+
+static void emuPrivateOp()
+{
+	const char message[64] = {};
+	uint8_t sign[RSA_SIGN_LEN];
+	sEmuSignKey->Sign(message, sizeof(message), sign);
+}
+
+static void emuLoginWork()
+{
+	emuPrivateOp();                                    // 요청 풀기
+	sEmuHasher->VerifyDummy("bot-password");           // Argon2id
+	emuPrivateOp();                                    // 응답 서명
+	emuPrivateOp();                                    // AuthAck 풀기
+	if ((++sEmuEntryCnt) % 2 == 0)
+	{
+		RsaKey fresh;                                  // 두 연결마다 다 쓴 서버 임시 키를 새로 만든다
+		fresh.Generate();
+	}
+}
+// ===== 측정용 끝 =====
 
