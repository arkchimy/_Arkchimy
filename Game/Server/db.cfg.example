// DB 접속 설정 예시 - 이 파일을 db.cfg로 복사해 값을 채운다(db.cfg는 .gitignore로 저장소에 올리지 않는다)
// BOM 없는 UTF-8
host = 127.0.0.1;
port = 3306;
user = game;
password = ;
database = trpg;
// 운영 툴이 운영자 포트에 처음 보내는 키(31바이트 이하) - 비우거나 지우면 운영자 포트를 열지 않는다. 운영 툴도 이 파일에서 읽는다
adminKey = ;
// Redis(세션 키, 로그인 서버·게임 서버가 같이 씀) - 127.0.0.1에만 묶고 비밀번호를 건다. 비밀번호는 16진수 등 영숫자로
redisHost = 127.0.0.1;
redisPort = 6379;
redisPassword = ;
// 모니터링 서버 키(31바이트 이하, 영숫자) - 로그인·게임 서버가 표본을 보낼 때, MonitorClient가 볼 때 처음 보내는 값. 비우면 보내지 않는다
monitorKey = ;
