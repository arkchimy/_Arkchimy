{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/tools/check_cpp_style.ps1\"",
            "timeout": 30,
            "statusMessage": "C++ 코딩 규칙 검사"
          }
        ]
      }
    ]
  }
}
